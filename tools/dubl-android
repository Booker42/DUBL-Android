#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
fail(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  install)
    mkdir -p "$HOME/.local/bin"
    ln -sf "$ROOT/tools/dubl-android" "$HOME/.local/bin/dubl-android"
    echo "Installed: dubl-android"
    ;;
  push)
    shift
    git add -A
    if ! git diff --cached --quiet; then
      git commit -m "${*:-android: update DUBL}"
    fi
    git push -u origin main
    echo "GitHub is building DUBL-Android-dev.apk in Actions."
    ;;
  release)
    VERSION="${2:-}"
    [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Usage: dubl-android release 0.1.3"
    [[ -z "$(git status --porcelain)" ]] || fail "Uncommitted changes. Run dubl-android push first."
    git switch main
    git pull --ff-only origin main
    TAG="v$VERSION"
    git rev-parse "$TAG" >/dev/null 2>&1 && fail "$TAG already exists"
    git tag -a "$TAG" -m "DUBL Android $VERSION"
    git push origin "$TAG"
    echo "Release build started: $TAG"
    ;;
  status)
    git status --short --branch
    if command -v gh >/dev/null 2>&1; then gh run list --limit 5 || true; fi
    ;;
  *)
    cat <<'USAGE'
DUBL Android helper

  dubl-android push [message]     commit + push to main; GitHub builds dev APK
  dubl-android release 0.1.3      create tag; GitHub builds signed Release APK
  dubl-android status             show git + recent Actions
  dubl-android install            install this helper into ~/.local/bin
USAGE
    ;;
esac
